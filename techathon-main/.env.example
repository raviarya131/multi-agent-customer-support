# ============================================================================
# Support Resolution Engine — environment
# Copy this file to `.env` at the repo root:  copy .env.example .env
# Every workspace (agent / api) walks up the tree and loads this one root .env.
# ============================================================================

# ----------------------------------------------------------------------------
# LLM — Groq (recommended free path for local setup)
# Get a key: https://console.groq.com/keys
# ----------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=groq

# ----------------------------------------------------------------------------
# LLM — custom OpenAI-compatible endpoint (optional alternative)
# Exactly THREE values. When LLM_ENDPOINT is set and LLM_PROVIDER=custom,
# the engine uses this endpoint instead of Groq.
# ----------------------------------------------------------------------------
# LLM_ENDPOINT=https://api.example.com/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-bearer-token
# LLM_PROVIDER=custom

# ----------------------------------------------------------------------------
# LLM — other optional providers
# ----------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
#
# Native Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=your-bearer-token
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ----------------------------------------------------------------------------
# Ports / service wiring
# ----------------------------------------------------------------------------
AGENT_PORT=5000
API_PORT=4100
AGENT_URL=http://localhost:5000
# SQLite file for the Application API (relative to apps/api).
API_DB_PATH=support.db

# NOTE: the web app reads its API URL from apps/web/.env.local, not this file:
#   NEXT_PUBLIC_API_URL=http://localhost:4100

# ----------------------------------------------------------------------------
# Routing thresholds (tune-able; sensible defaults baked in)
# ----------------------------------------------------------------------------
DOMAIN_THRESHOLD=0.3
CONFIDENCE_THRESHOLD=0.6
CLASSIFIER_MULTI_THRESHOLD=0.6
CLASSIFIER_FALLBACK_THRESHOLD=0.5
KB_TOP_SECTIONS=2

# ----------------------------------------------------------------------------
# Audit log — durable JSONL of every agent interaction. Set to `off` to disable
# the file (console logging always stays on).
# ----------------------------------------------------------------------------
AUDIT_LOG=on
AUDIT_LOG_FILE=logs/audit.jsonl
